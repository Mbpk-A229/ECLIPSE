[sub_resource type="Environment" id="Environment_luu17"]

[sub_resource type="GDScript" id="GDScript_faq51"]
script/source = "extends GeometryFactory

func _ready() -> void:
	await get_tree().process_frame

	# Mur en pierre grise
	create_shape({
		\"type\": \"box\",
		\"position\": Vector3(0, 2, 0),
		\"size\": Vector3(4, 4, 0.3),
		\"color\": Color(0.5, 0.5, 0.5)
	})

	# Toit en pente
	create_shape({
		\"type\": \"prism\",
		\"position\": Vector3(0, 4.2, 0),
		\"size\": Vector3(4, 1.5, 3),
		\"color\": Color(0.4, 0.2, 0.15)
	})

	# Fenêtre qui brille (émission jaune chaude)
	create_shape({
		\"type\": \"box\",
		\"position\": Vector3(1, 2, 0.15),
		\"size\": Vector3(0.8, 0.8, 0.05),
		\"collision\": false,
		\"color\": Color(1.0, 0.9, 0.6),
		\"emission_color\": Color(1.0, 0.85, 0.4),
		\"emission_energy\": 2.5
	})

	# Lampe à l'intérieur, toujours allumée
	create_light({
